# Adobe Tools - 通用防侧漏规则列表 (behavior: classical, format: text)
# 适用: Mihomo (format: text) / Clash / Surge / Quantumult X
# 订阅链接: https://raw.githubusercontent.com/Rita6333/Adobe-Tools/main/rules/mihomo/adobe-block.list

# 通配符域名后缀
DOMAIN-SUFFIX,adobegenuine.com
DOMAIN-SUFFIX,adobestats.io
DOMAIN-SUFFIX,adobe.io
DOMAIN-SUFFIX,adobelogin.com
DOMAIN-SUFFIX,licenses.adobe.com
DOMAIN-SUFFIX,oobesaas.adobe.com
DOMAIN-SUFFIX,cr.adobe.com
DOMAIN-SUFFIX,wip3.adobe.com
DOMAIN-SUFFIX,wip4.adobe.com

# 高危关键词匹配
DOMAIN-KEYWORD,adobegenuine
DOMAIN-KEYWORD,adobestats
DOMAIN-KEYWORD,adobe-dns
DOMAIN-KEYWORD,3dns
DOMAIN-KEYWORD,lmlicenses

